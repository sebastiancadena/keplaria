# Copy to .env.secrets and fill in. This file is excluded by BOTH .gitignore and
# .gcloudignore, which is the point: `agents-cli deploy` reads .env and injects
# every key it finds there as a plaintext runtime env var on the engine, echoing
# the values to stdout. Nothing reads this file except local tooling.
#
# Use it alongside .env, in this order:
#   uv run --env-file .env --env-file .env.secrets python scripts/erp.py audit
#
# Deployed services never read this file. Cloud Run wires the Frappe credentials
# from Secret Manager (frappe-api-key / frappe-api-secret) with --set-secrets,
# and the engine does not get them at all — it has no public internet egress and
# its graph never imports the executor, so it cannot reach the ERP.

# ERPNext (Frappe Cloud). TWO identities live here, and they are not
# interchangeable (README "ERPNext" explains both).
#
# FRAPPE_API_KEY / FRAPPE_API_SECRET — the SCOPED EXECUTOR
# (keplaria-executor), the only pair deployed services run as, wired from
# Secret Manager. Rotate in the Frappe UI (User -> API Access -> Generate
# Keys), then update Secret Manager and create new Cloud Run revisions so
# :latest is re-resolved.
FRAPPE_API_KEY=changeme
FRAPPE_API_SECRET=changeme

# FRAPPE_ADMIN_API_KEY / FRAPPE_ADMIN_API_SECRET — the site OWNER, read by
# scripts/erp.py alone (deleting needs rights the executor deliberately
# lacks). Local only: never in Secret Manager, never on a deployed service.
FRAPPE_ADMIN_API_KEY=changeme
FRAPPE_ADMIN_API_SECRET=changeme

# dev.to API key (Settings -> Extensions -> DEV Community API Keys).
DEVTO_API_KEY=
