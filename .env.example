# Copy to .env and fill in. SECRETS DO NOT GO IN THIS FILE OR IN .env.
#
# `agents-cli deploy` reads .env and injects EVERY key in it as a plaintext
# runtime env var on the deployed engine, echoing the values to stdout. There is
# no flag to exclude one. So anything secret goes in `.env.secrets` instead,
# which is excluded by both .gitignore and .gcloudignore, and local commands
# pass both files:
#
#   uv run --env-file .env --env-file .env.secrets python scripts/erp.py audit
#
# See README "Secrets". scripts/doctor.sh fails if a secret-shaped key appears
# in .env.

# Copy to .env and adjust. Contains no secrets — auth is via Application
# Default Credentials (gcloud auth application-default login).
#
# GOOGLE_GENAI_USE_ENTERPRISE routes the SDK to Gemini Enterprise Agent Platform
# endpoints. GOOGLE_GENAI_USE_VERTEXAI is the legacy alias for the same flag;
# setting both to conflicting values raises ValueError.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=keplaria
# global, not us-central1: gemini-3.6-flash 404s at us-central1 and only
# resolves at the global endpoint. Set on BOTH the Agent Runtime engine and
# the Cloud Run ingress. Infrastructure itself stays in us-central1 — this
# variable controls model-serving only, never resource location.
GOOGLE_CLOUD_LOCATION=global

# ERPNext (Frappe Cloud). Only the site hostname belongs here — it is not a
# secret. The key and secret go in .env.secrets (see the note at the top of this
# file) and, for deployed services, in Secret Manager as frappe-api-key /
# frappe-api-secret.
FRAPPE_SITE=https://your-site.frappe.cloud

# Firestore (transactional case state). FIRESTORE_PROJECT_ID is deliberately
# separate from GOOGLE_CLOUD_PROJECT: on Agent Runtime that var is reserved
# and platform-injected as the numeric project number, which Firestore's
# client rejects with a 404 on a database that actually exists. See
# app/state/firestore.py get_client().
FIRESTORE_PROJECT_ID=keplaria
FIRESTORE_DATABASE=(default)

# Agent Runtime engine, consumed by the ingress adapter (ingress/engine_client.py).
# AGENT_ENGINE_LOCATION is deliberately separate from GOOGLE_CLOUD_LOCATION
# above: the Agent Engine REST host is regional
# ("us-central1-aiplatform.googleapis.com"); a "global-aiplatform.googleapis.com"
# host does not exist. Set explicitly on the ingress deployment rather than
# relying on the code default.
AGENT_ENGINE_LOCATION=us-central1
AGENT_ENGINE_RESOURCE=projects/584548214478/locations/us-central1/reasoningEngines/REPLACE_ME
AGENT_APP_NAME=app

# Self-hosted screening service on the private VM
YENTE_BASE_URL=http://10.10.0.2:8000
YENTE_DATASET=keplaria_synthetic

# Review console (console/iap.py). The audience Cloud IAP signs its
# X-Goog-IAP-JWT-Assertion header for — must match this deployment's IAP
# resource exactly, or every reviewer identity is refused (fails closed, not
# open). Find the value with:
#   gcloud iap web get-iam-policy --resource-type=backend-services --format='value(name)'
# or from the Cloud Run service's IAP settings in the console. Unset in a
# deployed environment means the review endpoint refuses every request (503).
IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/global/services/BACKEND_SERVICE_ID

# dev.to API key (Settings -> Extensions -> DEV Community API Keys). Used only
# by the manual publish flow for docs/build-piece/article.dev.md; nothing in
# the deployed system reads it. It is a secret, so it lives in .env.secrets.
